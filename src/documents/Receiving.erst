@[Alias = "Приемка", ClientCreating = false, ShowDocumentsFromServerInList = true]
type Receiving of Document
{
    client function DocumentEditResult Edit(User currentUser, UserGroup currentGroup)
    {
        while (true) {
            string activeBoxBarcodeForMenu = ""
            bool activeBoxLookupFailedForMenu = false
            activeBoxBarcodeForMenu = GetActiveReceivingBoxBarcode(this.Id)
            on fail {
                Alert(Message = "Не удалось проверить текущую коробку")
                activeBoxLookupFailedForMenu = true
            }

            bool canCloseBox = !activeBoxLookupFailedForMenu && activeBoxBarcodeForMenu != ""
            string selectedMenuAction = SelectReceivingMenuAction(canCloseBox)
            if (selectedMenuAction == "") {
                if (ConfirmTemporaryExit()) {
                    return DocumentEditResult.Abort
                }
                continue
            }

            if (selectedMenuAction == "receive") {
                string enteredSealNumber = this.SealNumber
                bool sealEntryCancelled = false
                if (enteredSealNumber == "") {
                    EditField(
                        WelcomeText = "Введите номер пломбы:",
                        EditType = FieldEditType.Session,
                        Field = enteredSealNumber,
                        CancelText = "Назад",
                        Controls = [new Control{DisplayText = "Назад", Action = _cancelSeal, Key = Keys.Escape}]
                    )
                    on _cancelSeal {
                        sealEntryCancelled = true
                    }
                }
                if (sealEntryCancelled || enteredSealNumber == "") {
                    continue
                }
                this.SealNumber = enteredSealNumber

                DocumentItemCollection workingExpectedLines = this.ExpectedLines
                Container currentBox = SelectReceivingBox(this.Id, this.BoxDepth)
                if (currentBox == null) {
                    continue
                }
                while (true) {
                    if (workingExpectedLines.Completed) {
                        Alert(Message = "Задание полностью собрано")
                        return DocumentEditResult.OK
                    }

                    InventoryItemCollection documentInventoryItems = workingExpectedLines.InventoryItems
                    if (documentInventoryItems.Count == 0) {
                        Alert(Message = "В задании нет товаров")
                        break
                    }

                    int occupiedPlaces = 0
                    int boxCapacity = 0
                    (occupiedPlaces, boxCapacity) = GetReceivingBoxUsage(this.Id, currentBox.Barcode)
                    on fail {
                        Alert(Message = "Не удалось получить заполнение коробки")
                        break
                    }
                    string currentBoxBarcode = currentBox.Barcode
                    bool productScanCancelled = false
                    InventoryItemRecord selectedProduct = null
                    if (this.ShowDocumentItemsDuringScan) {
                        (selectedProduct, productScanCancelled) = ScanReceivingProductWithDocumentList(
                            workingExpectedLines,
                            currentBoxBarcode,
                            occupiedPlaces,
                            boxCapacity
                        )
                    }
                    else {
                        (selectedProduct, string _1, BarcodeData _2) = ScanAndSearch(
                            WelcomeText = "Отсканируйте штрихкод товара:",
                            HeaderText = "Коробка {currentBoxBarcode}: занято {occupiedPlaces} из {boxCapacity} мест",
                            SaveInHistory = false,
                            NotFoundErrorText = "Товар не найден",
                            UseOnlyDocumentInventoryItems = UseOnlyDocumentInventoryItems.No,
                            SearchingInventoryItems = documentInventoryItems,
                            InventoryItemsListHeaderText = "Товары документа",
                            CancelText = "Назад",
                            Controls = [new Control{DisplayText = "Назад", Action = _cancelProduct, Key = Keys.Escape}]
                        )
                        on _cancelProduct {
                            productScanCancelled = true
                        }
                        on fail {
                            productScanCancelled = true
                        }
                    }
                    if (productScanCancelled) {
                        break
                    }
                    if (selectedProduct == null) {
                        continue
                    }

                    string batchNumber = ""
                    bool batchEntryCancelled = false
                    EditField(
                        WelcomeText = "Введите номер партии:",
                        HeaderText = "Коробка {currentBoxBarcode}: занято {occupiedPlaces} из {boxCapacity} мест",
                        SaveInHistory = false,
                        EditType = FieldEditType.Session,
                        Field = batchNumber,
                        CancelText = "Назад",
                        Controls = [new Control{DisplayText = "Назад", Action = _cancelBatch, Key = Keys.Escape}]
                    )
                    on _cancelBatch {
                        batchEntryCancelled = true
                    }
                    if (batchEntryCancelled || batchNumber == "") {
                        continue
                    }
                    int receivedQuantity = 1
                    if (this.ManualQuantityInput) {
                        (bool quantityConfirmed, int enteredQuantity) = EnterReceivingQuantity(
                            occupiedPlaces,
                            boxCapacity
                        )
                        if (!quantityConfirmed) {
                            continue
                        }
                        receivedQuantity = enteredQuantity
                    }

                    int remainingBoxPlaces = GetReceivingBoxRemainingPlaces(this.Id, currentBox.Barcode)
                    on fail {
                        Alert(Message = "Не удалось получить остаток мест в коробке")
                        break
                    }
                    if (receivedQuantity > remainingBoxPlaces) {
                        Alert(Message = "В коробке недостаточно свободных мест для такого количества")
                        continue
                    }

                    selectedProduct.BatchNumber = batchNumber
                    selectedProduct.BoxBarcode = currentBox.Barcode
                    selectedProduct.Quantity = receivedQuantity

                    (DocumentItemCollection changedActualLines, DocumentItemCollection _3) = CommitInventoryRecord(
                        CheckQuantity = true,
                        ErrorQuantityMessage = "Количество товара превышает задание",
                        NoInventoryItemInDocumentMessage = "Товар отсутствует в задании",
                        ComparingFieldNames = ["InventoryItemId", "UnitOfMeasureId"],
                        ComparingFieldNamesForActualLines = [
                            "InventoryItemId",
                            "UnitOfMeasureId",
                            "BatchNumber",
                            "BoxBarcode"
                        ],
                        CheckDocumentInfill = true,
                        CombineEqualActualLines = true,
                        ExpectedLines = workingExpectedLines
                    )
                    on fail {
                        Alert(Message = "Товар не добавлен: он отсутствует в задании или его количество уже полностью принято")
                        continue
                    }
                    if (changedActualLines == null || changedActualLines.Count == 0) {
                        Alert(Message = "Товар не был сохранен")
                        continue
                    }

                    ReceivingBoxStatus boxStatus = OccupyReceivingBoxPlace(
                        this.Id,
                        currentBox.Barcode,
                        receivedQuantity
                    )
                    on fail {
                        Alert(Message = "Не удалось обновить заполнение коробки")
                        break
                    }

                    occupiedPlaces = occupiedPlaces + receivedQuantity
                    GO.ShowBaloon(
                        "Коробка {currentBoxBarcode}: занято {occupiedPlaces} из {boxCapacity} мест",
                        3000,
                        false
                    )

                    if (workingExpectedLines.Completed) {
                        Alert(Message = "Задание полностью собрано")
                        return DocumentEditResult.OK
                    }

                    if (boxStatus == ReceivingBoxStatus.Filled) {
                        Alert(Message = "Коробка заполнена. Закройте ее и отсканируйте следующую.")
                        currentBox = SelectReceivingBox(this.Id, this.BoxDepth)
                        if (currentBox == null) {
                            break
                        }
                    }
                }
                continue
            }
            if (selectedMenuAction == "viewProducts") {
                ViewReceivingProducts(this.ExpectedLines, this.ActualLines)
                continue
            }
            if (selectedMenuAction == "closeBox") {
                string activeBoxBarcodeToClose = GetActiveReceivingBoxBarcode(this.Id)
                on fail {
                    Alert(Message = "Не удалось получить текущую коробку")
                    continue
                }

                if (activeBoxBarcodeToClose == "") {
                    Alert(Message = "Нет коробки, которую можно закрыть")
                    continue
                }

                bool boxClosed = CloseReceivingBoxManually(this.Id, activeBoxBarcodeToClose)
                if (boxClosed) {
                    Alert(Message = "Текущая коробка закрыта. Можно изменить глубину и отсканировать следующую.")
                }
                else {
                    Alert(Message = "Коробку можно закрыть только если в ней свободно ровно 2 грузовых места")
                }
                continue
            }
            if (selectedMenuAction == "settings") {
                bool activeBoxLookupFailed = false
                string activeBoxBarcode = GetActiveReceivingBoxBarcode(this.Id)
                on fail {
                    Alert(Message = "Не удалось получить текущую коробку")
                    activeBoxLookupFailed = true
                }
                if (activeBoxLookupFailed) {
                    continue
                }

                bool canChangeBoxDepth = activeBoxBarcode == ""
                string selectedSettingsAction = SelectReceivingSettingsAction(canChangeBoxDepth)
                if (selectedSettingsAction == "boxDepth") {
                    int newDepth = this.BoxDepth
                    bool boxDepthEntryCancelled = false
                    EditField(
                        WelcomeText = "Введите новую глубину коробок",
                        EditType = FieldEditType.Session,
                        Field = newDepth,
                        CancelText = "Назад",
                        Controls = [new Control{DisplayText = "Назад", Key = Keys.Escape, Action = _cancelBoxDepth}]
                    )
                    on _cancelBoxDepth {
                        boxDepthEntryCancelled = true
                    }

                    if (!boxDepthEntryCancelled) {
                        if (newDepth <= 0) {
                            Alert(Message = "Глубина коробок должна быть больше нуля")
                        }
                        else {
                            bool canSaveDepth = true
                            string latestActiveBoxBarcode = GetActiveReceivingBoxBarcode(this.Id)
                            on fail {
                                Alert(Message = "Не удалось повторно проверить текущую коробку")
                                canSaveDepth = false
                            }

                            if (canSaveDepth && latestActiveBoxBarcode != "") {
                                Alert(Message = "Глубину нельзя изменить: текущая коробка уже находится в работе")
                                canSaveDepth = false
                            }

                            if (canSaveDepth) {
                                this.BoxDepth = newDepth
                            }
                        }
                    }
                }
                if (selectedSettingsAction == "quantityMode") {
                    string selectedQuantityMode = SelectReceivingQuantityModeAction()
                    if (selectedQuantityMode == "automatic") {
                        this.ManualQuantityInput = false
                        Alert(Message = "Установлен автоматический режим количества")
                    }
                    if (selectedQuantityMode == "manual") {
                        this.ManualQuantityInput = true
                        Alert(Message = "Установлен ручной режим количества")
                    }
                }
                if (selectedSettingsAction == "workMode") {
                    string selectedWorkMode = SelectReceivingWorkModeAction()
                    if (selectedWorkMode == "showDocumentItems") {
                        this.ShowDocumentItemsDuringScan = true
                        Alert(Message = "Список задания будет показан во время сканирования")
                    }
                    if (selectedWorkMode == "scanOnly") {
                        this.ShowDocumentItemsDuringScan = false
                        Alert(Message = "Установлен режим только сканирования")
                    }
                }
                continue
            }
            if (selectedMenuAction == "exit") {
                if (ConfirmTemporaryExit()) {
                    return DocumentEditResult.Abort
                }
                continue
            }
        }
    }
}
