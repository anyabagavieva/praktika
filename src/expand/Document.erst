expand Document
{
    string SealNumber
    int BoxDepth = ReceivingSettings.DefaultBoxDepth
    bool ManualQuantityInput = ReceivingSettings.DefaultManualQuantityInput
    bool ShowDocumentItemsDuringScan = ReceivingSettings.DefaultShowDocumentItemsDuringScan

    expand InventoryItemRecord
    {
        string BatchNumber
        string BoxBarcode
    }

    expand DocumentItem
    {
        string PartNumber
        string BatchNumber
        string BoxBarcode
    }
}
