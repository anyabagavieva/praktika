type ReceivingSettings of Settings
{
    @[DeviceAccessibility = Read]
    @[ServerAccessibility = Read]
    int DefaultBoxDepth = 10

    @[DeviceAccessibility = Read]
    @[ServerAccessibility = Read]
    bool DefaultManualQuantityInput = false

    @[DeviceAccessibility = Read]
    @[ServerAccessibility = Read]
    bool DefaultShowDocumentItemsDuringScan = false
}
