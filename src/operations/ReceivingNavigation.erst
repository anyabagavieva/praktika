client function bool ConfirmTemporaryExit()
{
    string exitPassword = ""
    bool passwordEntryCancelled = false
    EditField(
        WelcomeText = "Введите пароль начальника смены:",
        EditType = FieldEditType.Session,
        Field = exitPassword,
        CancelText = "Назад",
        Controls = [new Control{DisplayText = "Назад", Action = _cancelPassword, Key = Keys.Escape}]
    )
    on _cancelPassword {
        passwordEntryCancelled = true
    }
    if (passwordEntryCancelled || exitPassword == "") {
        return false
    }

    if (exitPassword == "2408") {
        return true
    }

    Alert(Message = "Неверный пароль")
    return false
}

client function string SelectReceivingMenuAction(bool canCloseBox)
{
    string selectedAction = ""
    Menu(
        Buttons = [
            new Control{DisplayText = "Прием товара", Action = _receive},
            new Control{DisplayText = "Просмотр товаров", Action = _viewProducts},
            new Control{DisplayText = "Закрыть текущую коробку", Action = _closeBox, Enabled = canCloseBox},
            new Control{DisplayText = "Настройки", Action = _settings},
            new Control{DisplayText = "Выйти", Action = _exit, Key = Keys.Escape}
        ],
        CancelText = "Выйти"
    )
    on _receive {
        selectedAction = "receive"
    }
    on _viewProducts {
        selectedAction = "viewProducts"
    }
    on _closeBox {
        selectedAction = "closeBox"
    }
    on _settings {
        selectedAction = "settings"
    }
    on _exit {
        selectedAction = "exit"
    }

    return selectedAction
}

client function string SelectReceivingSettingsAction(bool canChangeBoxDepth)
{
    string selectedAction = ""
    Menu(
        Buttons = [
            new Control{DisplayText = "Глубина коробок", Action = _boxDepth, Enabled = canChangeBoxDepth},
            new Control{DisplayText = "Режим количества", Action = _quantityMode},
            new Control{DisplayText = "Режим работы", Action = _workMode}
